# Optional cloud accounts/projects. Leave absent for the credential-free guest editor.
# pnpm supabase:start generates .env.local for an isolated local stack.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Set the actual HTTPS app origin for a hosted deployment; loopback HTTP is local-only.
FITSPACE_SITE_URL=http://127.0.0.1:3000
# Never put service-role/secret keys in the application environment or this file.
